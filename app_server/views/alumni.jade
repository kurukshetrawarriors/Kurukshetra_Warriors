extends layout

block content
  h1= title
  h2 User Information Table

  //- Table styling
  style.
    table {
      width: 80%;
      margin: 20px auto;
      border-collapse: collapse;
    }
    th, td {
      border: 5px solid black;
      padding: 10px;
      text-align: center;
    }
    th {
      background-color: gold ;
    }
    td{
      background-color: #f0f8ff;
      color: #333;
    }
    
    .button {
      padding: 5px 10px;
      background-color: #007bff;
      color: white;
      border: none;
      border-radius: 4px;
      cursor: pointer;
    }
    .button:hover {
      background-color:red ;
    }

